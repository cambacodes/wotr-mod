      "ShowOnceCurrentDialog": false,
      "Conditions": {
        "Operation": "And",
        "Conditions": [
          {
            "$type": "4d2b3bd16c3f2bf4ebb8a19907e2be7e, CueSeen",
            "name": "$CueSeen$93c846ae-dea0-4c92-8a5a-6e6a18b16269",
            "Not": false,
            "m_Cue": "!bp_bffcd163de8499046a62b8f22073e15b",
            "CurrentDialog": false
          }
        ]
