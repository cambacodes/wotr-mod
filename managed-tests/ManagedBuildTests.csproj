<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ModAssemblyPath Condition="'$(ModAssemblyPath)' == ''">../src/bin/Release/net48/RanRomance.Tirabade.dll</ModAssemblyPath>
    <GameDir Condition="'$(GameDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Pathfinder Second Adventure\</GameDir>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../tests/PresenceRuntimeF9Tests.cs" Link="PresenceRuntimeF9Tests.cs" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="$(GameDir)Wrath_Data\Managed\*.dll" Exclude="$(GameDir)Wrath_Data\Managed\System*.dll;$(GameDir)Wrath_Data\Managed\mscorlib.dll;$(GameDir)Wrath_Data\Managed\netstandard.dll" Private="false" />
    <Reference Include="$(GameDir)Wrath_Data\Managed\UnityModManager\UnityModManager.dll" Private="false" />
    <Reference Include="$(GameDir)Wrath_Data\Managed\UnityModManager\0Harmony.dll" Private="false" />
    <Reference Include="$(ModAssemblyPath)" Private="false" />
  </ItemGroup>
</Project>
