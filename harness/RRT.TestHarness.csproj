<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <AssemblyName>RRT.TestHarness</AssemblyName>
    <RootNamespace>RRT.TestHarness</RootNamespace>
    <GameDir Condition="'$(GameDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Pathfinder Second Adventure\</GameDir>
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <!-- The offline self-test is a separate console project. -->
    <Compile Remove="SelfTest/**" />
    <None Remove="SelfTest/**" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="$(GameDir)Wrath_Data\Managed\*.dll" Exclude="$(GameDir)Wrath_Data\Managed\System*.dll;$(GameDir)Wrath_Data\Managed\mscorlib.dll;$(GameDir)Wrath_Data\Managed\netstandard.dll" Private="false" />
    <Reference Include="$(GameDir)Wrath_Data\Managed\UnityModManager\UnityModManager.dll" Private="false" />
    <Reference Include="$(GameDir)Wrath_Data\Managed\UnityModManager\0Harmony.dll" Private="false" />
  </ItemGroup>
  <ItemGroup>
    <None Update="Info.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
